# Mini Crawler local development environment (P00 Item 4).
# Copy this file to `.env` and adjust values. `.env` is git-ignored and must
# never contain real production secrets.

APP_PROFILE=local
APP_SECRET_KEY=dev-secret-change-me
APP_PORT=8000

POSTGRES_DB=minicrawler
POSTGRES_USER=minicrawler
POSTGRES_PASSWORD=devpassword

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

SEARXNG_SECRET=dev-secret-change-me

DATABASE_URL=postgresql+psycopg://minicrawler:devpassword@localhost:5432/minicrawler
REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
SEARXNG_URL=http://localhost:8080

# Local runtime without Docker (see STARTUP.md). Docker keeps the defaults above.
# APP_RUNTIME_MODE=inline
# DATABASE_URL=sqlite:///./.runtime/local.db
# APP_LOCAL_STORAGE_PATH=./.runtime/objects
# APP_SEARCH_ENABLED=false
# APP_LOCAL_WORKER_POLL_SECONDS=1.0
